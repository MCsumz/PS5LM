+// PS5LM: text that already holds the media marker made mtmd count one media part more than the
+// request had, and every later request of that chat failed with "Failed to tokenize prompt".
+// /props publishes the marker, so a tool that read it was enough. Only the media parts that
+// oaicompat_content_load_media makes may carry it; elsewhere it is written as [media marker].
+static void oaicompat_strip_media_marker(json & j) {
+    if (j.is_string()) {
+        std::string text = j.get<std::string>();
+        if (text.find(get_media_marker()) != std::string::npos) {
+            string_replace_all(text, get_media_marker(), "[media marker]");
+            j = text;
+        }
+    } else if (j.is_array() || j.is_object()) {
+        for (auto & v : j) {
+            oaicompat_strip_media_marker(v);
+        }
     }
 }
 
